// CINAB firebase.json — visiekaart
// VERSIE: 1.2.0 — 10 oktober 2026
//   1.2.0 — Cache-Control no-cache op html en js: elke deploy is meteen zichtbaar
//           (Firebase liet browsers HTML een uur cachen).
//   1.1.0 — join-rewrite vervangen door een 302-redirect naar visiekaart_fase0.html?join=,
//           conform B-01 uit het testprotocol: visiekaart_join.html bestaat niet meer en een
//           interne rewrite laat de URL op /join/ staan, waardoor de relatieve fase-navigatie
//           op het deelnemer-apparaat breekt. CSP aangevuld met het kale cinab.nl.
//   1.0.0 — versieregel toegevoegd; configuratie zelf ongewijzigd.
{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/join/:code",
        "destination": "/visiekaart_fase0.html?join=:code",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/visiekaart_rapport.html",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'self' https://cinab.nl https://staging2.cinab.nl https://*.cinab.nl"
          }
        ]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
