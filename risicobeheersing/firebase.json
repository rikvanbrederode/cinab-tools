// CINAB firebase.json — risicobeheersing
// VERSIE: 1.1.0 — 10 oktober 2026 (Cache-Control no-cache op html en js: elke deploy is
// meteen zichtbaar; Firebase liet browsers HTML een uur cachen)
// 1.0.0 — 3 september 2026 (versieregel toegevoegd; CSP aangevuld met het kale
// cinab.nl; join-rewrite verwijderd zolang risicobeheersing_join.html niet bestaat)
{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/risicobeheersing_rapport.html",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'self' https://cinab.nl https://staging2.cinab.nl https://*.cinab.nl"
          }
        ]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
