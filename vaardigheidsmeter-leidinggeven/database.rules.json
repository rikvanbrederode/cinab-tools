// CINAB database.rules.json — vaardigheidsmeter-leidinggeven
// VERSIE: 2.0.0 — 3 september 2026
//   2.0.0 — regels van de tooldeveloper (v0.5) overgenomen. Strakker dan de vorige set:
//           de ongebruikte tak 'raters' is eruit en een vangnet '$other' weigert alles wat
//           niet expliciet is toegestaan. De app schrijft alleen naar meta, content, state
//           en answers; dat is nagelopen in beide bladen voordat dit werd overgenomen.
//   1.0.0 — versieregel toegevoegd; regels zelf ongewijzigd.
{
  "rules": {
    "sessions": {
      ".read": false,
      ".write": false,
      "$code": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('facilitatorUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['createdAt','facilitatorUid']) && newData.child('facilitatorUid').val() === auth.uid"
        },
        "content": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('sessions').child($code).child('meta/facilitatorUid').val() === auth.uid"
        },
        "state": {
          ".read": "auth != null && root.child('sessions').child($code).child('meta/facilitatorUid').val() === auth.uid",
          ".write": "auth != null && root.child('sessions').child($code).child('meta/facilitatorUid').val() === auth.uid"
        },
        "answers": {
          ".read": "auth != null && root.child('sessions').child($code).child('meta/facilitatorUid').val() === auth.uid",
          "$pushId": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.hasChildren(['name','naamZichtbaar','vals','at']) && newData.child('name').isString() && newData.child('name').val().length <= 120 && newData.child('naamZichtbaar').isBoolean() && (!newData.hasChild('email') || (newData.child('email').isString() && newData.child('email').val().length <= 200))",
            "vals": {
              "$lv": {
                ".validate": "$lv.matches(/^LV([1-9]|1[0-9]|20)$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
              }
            }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
